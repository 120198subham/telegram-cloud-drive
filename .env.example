# Telegram MTProto API Credentials (from https://my.telegram.org)
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=your_api_hash_here

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Target Telegram Private Channel IDs
TELEGRAM_CHANNEL_ID=-1001234567890
TELEGRAM_TODO_CHANNEL_ID=-1001234567891
TELEGRAM_SOFTWARE_CHANNEL_ID=-1001234567892
TELEGRAM_OTP_CHANNEL_ID=-1001234567893

# Telegram Owner ID (from @userinfobot) for receiving direct private messages (optional)
TELEGRAM_OWNER_ID=0

# OTP Authentication Settings
OTP_MAX_REQUESTS_PER_MIN=4
OTP_EXPIRY_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_SECONDS=600
OTP_AUTO_DELETE_SECONDS=180

